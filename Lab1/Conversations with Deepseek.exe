❌ 调试麻烦：改一处可能需要重新编译多个文件

❌ 提交麻烦：多个文件要组织好目录结构

二、我的建议：用单个文件实现
理由：

本次实验核心是“性能对比分析”，不是“工程架构设计”

助教更关心你的实验结果和分析，而不是你分了多少个文件

你在 VSCode 上操作，单文件按 Ctrl+Alt+B 就能编译运行，最省事

报告中贴代码时，单文件也更整洁

三、单文件的最佳实践
为了避免代码乱成一团，可以用 命名空间 或 静态函数 分隔：

cpp
#include <iostream>
#include <vector>
#include <chrono>
#include <cmath>

using namespace std;
using namespace chrono;

// ==================== 任务1：矩阵列内积 ====================
namespace MatrixVector {
    // 平凡算法：逐列访问
    vector<double> naive(const vector<vector<double>>& A, const vector<double>& b) {
        int n = A.size();
        vector<double> result(n, 0.0);
        for (int j = 0; j < n; ++j) {
            for (int i = 0; i < n; ++i) {
                result[j] += A[i][j] * b[i];
            }
        }
        return result;
    }
    
    // Cache优化算法：按行访问
    vector<double> cacheOptimized(const vector<vector<double>>& A, const vector<double>& b) {
        int n = A.size();
        vector<double> result(n, 0.0);
        for (int i = 0; i < n; ++i) {
            double bi = b[i];
            for (int j = 0; j < n; ++j) {
                result[j] += A[i][j] * bi;
            }
        }
        return result;
    }
}

// ==================== 任务2：数组求和 ====================
namespace Sum {
    // 平凡算法：链式累加
    double naive(const vector<double>& arr) {
        double sum = 0.0;
        for (double x : arr) {
            sum += x;
        }
        return sum;
    }
    
    // 两路累加（指令级并行优化）
    double twoWay(const vector<double>& arr) {
        double sum0 = 0.0, sum1 = 0.0;
        size_t i = 0;
        for (; i + 1 < arr.size(); i += 2) {
            sum0 += arr[i];
            sum1 += arr[i + 1];
        }
        // 处理剩余元素
        for (; i < arr.size(); ++i) {
            sum0 += arr[i];
        }
        return sum0 + sum1;
    }
}

// ==================== 计时工具 ====================
template<typename Func>
double measureTime(Func func, int repeatTimes = 10) {
    auto start = high_resolution_clock::now();
    for (int i = 0; i < repeatTimes; ++i) {
        func();
    }
    auto end = high_resolution_clock::now();
    return duration<double>(end - start).count() / repeatTimes;
}

// ==================== 主函数 ====================
int main() {
    vector<int> sizes = {64, 256, 1024, 2048, 4096};
    
    cout << "========== 矩阵列内积性能对比 ==========" << endl;
    for (int n : sizes) {
        // 生成测试数据
        vector<vector<double>> A(n, vector<double>(n, 1.0));
        vector<double> b(n, 1.0);
        
        auto naiveTime = measureTime([&]() {
            MatrixVector::naive(A, b);
        });
        
        auto cacheTime = measureTime([&]() {
            MatrixVector::cacheOptimized(A, b);
        });
        
        cout << "n=" << n 
             << " | 平凡算法: " << naiveTime * 1000 << " ms"
             << " | cache优化: " << cacheTime * 1000 << " ms"
             << " | 加速比: " << naiveTime / cacheTime << endl;
    }
    
    cout << "\n========== 数组求和性能对比 ==========" << endl;
    for (int n : sizes) {
        vector<double> arr(n, 1.0);
        
        auto naiveTime = measureTime([&]() {
            Sum::naive(arr);
        });
        
        auto twoWayTime = measureTime([&]() {
            Sum::twoWay(arr);
        });
        
        cout << "n=" << n 
             << " | 平凡算法: " << naiveTime * 1000 << " ms"
             << " | 两路累加: " << twoWayTime * 1000 << " ms"
             << " | 加速比: " << naiveTime / twoWayTime << endl;
    }
    
    return 0;
}
四、在 VSCode 中编译运行
保存文件：benchmark.cpp

打开终端：`Ctrl + ``（反引号）

编译：

bash
g++ -O2 -o benchmark benchmark.cpp
运行：

bash
./benchmark
五、最终建议
对比项	单文件	多文件
本次实验推荐度	⭐⭐⭐⭐⭐	⭐⭐
代码量	200-300行	200-300行
编译复杂度	一条命令	需要 Makefile
调试方便度	非常方便	稍麻烦
报告贴代码	整洁	需要贴多个文件
结论：用单文件 + namespace 分隔，既清晰又省事。

